{
  "name": "codex-as-subagent",
  "version": "0.1.0",
  "description": "A controlled Codex subagent runtime for coding-agent hosts.",
  "private": true,
  "type": "module",
  "bin": {
    "codex-as-subagent": "src/cli/main.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.mjs'",
    "lint": "find src -type f -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "smoke": "./src/cli/main.mjs --help",
    "install:zcode": "./src/cli/main.mjs install --host=zcode",
    "install:zcode:dry": "./src/cli/main.mjs install --host=zcode --dry-run",
    "install:kimi-code": "./src/cli/main.mjs install --host=kimi-code",
    "install:kimi-code:dry": "./src/cli/main.mjs install --host=kimi-code --dry-run"
  }
}
